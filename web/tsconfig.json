{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Browser code: the crypto layer uses WebCrypto, btoa and TextEncoder, all
    // of which come from the DOM lib rather than from Node.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "@onetime/contracts": ["../packages/contracts/src/index.ts"]
    }
  },
  "include": ["lib/**/*.ts", "app/**/*.ts", "app/**/*.tsx", "*.ts", "*.mjs"],
  // Tests are excluded because `next build` type-checks against this file, and
  // a deploy must not depend on test-only packages being installed. They are
  // still checked in full by tsconfig.test.json, which npm run typecheck runs.
  "exclude": ["node_modules", ".next", "**/*.test.ts"]
}
